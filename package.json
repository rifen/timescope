{
  "name": "timescope",
  "version": "0.2.29",
  "packageManager": "pnpm@11.24.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @rifen/timescope-core build && pnpm --filter timescope-nvim build && pnpm --filter timescope-nvim test:e2e && pnpm --filter rifen-timescope test:e2e",
    "test:manual:vscode": "pnpm --filter rifen-timescope quick-test",
    "test:manual:nvim": "pnpm --filter timescope-nvim test:manual",
    "lint": "pnpm -r run lint",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check-versions": "node scripts/check-versions.mjs",
    "security:opengrep": "opengrep scan --config auto --error .",
    "security:opengrep:server": "opengrep --server",
    "setup:git-hooks": "sh ./scripts/setup-git-hooks.sh",
    "timescope": "node packages/core/dist/cli.js",
    "package:core": "pnpm --filter @rifen/timescope-core run build",
    "package:vscode": "pnpm --filter rifen-timescope run package",
    "package:nvim": "pnpm --filter timescope-nvim run build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}