{
  "name": "timescope-mono",
  "version": "0.2.25",
  "packageManager": "pnpm@11.24.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "timescope": "node packages/core/dist/cli.js",
    "package:core": "pnpm --filter @rifen/timescope-core run build",
    "package:vscode": "pnpm --filter timelens-vscode run package",
    "package:nvim": "pnpm --filter timelens-nvim run build"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "mocha": "^11.8.0",
    "serialize-javascript": "^7.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}