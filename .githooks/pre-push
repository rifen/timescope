#!/usr/bin/env sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Refusing direct push to $remote_ref." >&2
      echo "Create a fresh branch and open a pull request instead." >&2
      exit 1
      ;;
  esac
done

exit 0
