{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../test-data/manual",
        "${workspaceFolder}/../../test-data/manual/durations.py",
        "${workspaceFolder}/../../test-data/manual/durations.ts",
        "${workspaceFolder}/../../test-data/manual/durations.js",
        "${workspaceFolder}/../../test-data/manual/durations.go",
        "${workspaceFolder}/../../test-data/manual/durations.rs",
        "${workspaceFolder}/../../test-data/manual/durations.java",
        "${workspaceFolder}/../../test-data/manual/durations.cs",
        "${workspaceFolder}/../../test-data/manual/durations.yaml",
        "${workspaceFolder}/../../test-data/manual/durations.json",
        "${workspaceFolder}/../../test-data/manual/durations.toml",
        "${workspaceFolder}/../../test-data/manual/durations.lua"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm:compile"
    },
    {
      "name": "Extension Development Host (Clean - No Extensions)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensions-dir=${workspaceFolder}/.test-extensions",
        "${workspaceFolder}/../../test-data/manual",
        "${workspaceFolder}/../../test-data/manual/durations.py",
        "${workspaceFolder}/../../test-data/manual/durations.ts",
        "${workspaceFolder}/../../test-data/manual/durations.js",
        "${workspaceFolder}/../../test-data/manual/durations.go",
        "${workspaceFolder}/../../test-data/manual/durations.rs",
        "${workspaceFolder}/../../test-data/manual/durations.java",
        "${workspaceFolder}/../../test-data/manual/durations.cs",
        "${workspaceFolder}/../../test-data/manual/durations.yaml",
        "${workspaceFolder}/../../test-data/manual/durations.json",
        "${workspaceFolder}/../../test-data/manual/durations.toml",
        "${workspaceFolder}/../../test-data/manual/durations.lua"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm:compile"
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/dist-test/test/suite/index.js"
      ],
      "outFiles": ["${workspaceFolder}/dist-test/**/*.js"],
      "preLaunchTask": "npm:compile"
    }
  ]
}