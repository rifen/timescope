{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@rifen/timescope-core": ["../core/dist/index.d.ts"]
    },
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "dist",
    "lib": ["ES2021"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test", "out", "test"]
}